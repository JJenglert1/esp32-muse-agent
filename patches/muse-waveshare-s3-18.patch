diff --git a/esp32/components/muse/boards/board_waveshare_s3_18.c b/esp32/components/muse/boards/board_waveshare_s3_18.c
new file mode 100644
index 0000000..06853b5
--- /dev/null
+++ b/esp32/components/muse/boards/board_waveshare_s3_18.c
@@ -0,0 +1,471 @@
+/*
